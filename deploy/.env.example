# Copy to .env and fill in real values. The file is git-ignored.
#
# Public hostname players will open in a browser. Do NOT include a scheme or
# port; the client appends :8000 / :8001 for the socket servers itself.
DOMAIN=play.example.com

# Email used by Caddy for Let's Encrypt expiry notices.
ACME_EMAIL=you@example.com

# Firebase project id (used by the client SDK config baked into the bundle).
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase Realtime Database URL. A trailing slash is added by the build when
# missing. Regional URLs such as
# https://<project>-default-rtdb.asia-southeast1.firebasedatabase.app/ work with
# the Firebase v8 SDK used by this game.
FIREBASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app/

# Firebase Web API key (client SDK config, not a secret). Used by the client to
# sign in with the server-issued custom token (signInWithCustomToken).
FIREBASE_API_KEY=your-firebase-web-api-key

# HS256 secret used by the API to sign JWTs and by game/sp to verify them.
# Generate with: openssl rand -hex 32
TOKEN_SECRET=change-me-to-a-long-random-string

# Password for the bundled Postgres container.
POSTGRES_PASSWORD=change-me-to-a-strong-password
