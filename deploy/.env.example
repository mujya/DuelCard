# Copy to .env and fill in real values. The file is git-ignored.
#
# Public hostname players will open in a browser. Do NOT include a scheme or
# port; the client appends :8000 / :8001 for the socket servers itself.
DOMAIN=play.example.com

# Email used by Caddy for Let's Encrypt expiry notices.
ACME_EMAIL=you@example.com

# Firebase Realtime Database URL. Must end with a slash for the client build.
# Create it in the US Central region; other regions are incompatible with the
# legacy Firebase client used by this game.
FIREBASE_URL=https://your-project-default-rtdb.firebaseio.com/

# Firebase Web API key (client SDK config, not a secret). Used to exchange the
# server-issued custom token for an ID token.
FIREBASE_API_KEY=your-firebase-web-api-key

# HS256 secret used by the API to sign JWTs and by game/sp to verify them.
# Generate with: openssl rand -hex 32
TOKEN_SECRET=change-me-to-a-long-random-string

# Password for the bundled Postgres container.
POSTGRES_PASSWORD=change-me-to-a-strong-password
