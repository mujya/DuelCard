# Caddyfile for a single-server OpenDuelyst deployment.
#
# Caddy obtains and renews the TLS certificate for $DOMAIN automatically, so
# DNS must point at this server and ports 80/443 must be reachable before the
# first start.
#
# The game client connects to the socket.io servers on fixed ports 8000 (SP)
# and 8001 (MP), and expects TLS (wss://) because the web client was built with
# NODE_ENV=production. Keep those ports open and proxied here.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy api:3000
}

https://{$DOMAIN}:8000 {
	reverse_proxy sp:8000
}

https://{$DOMAIN}:8001 {
	reverse_proxy game:8001
}
