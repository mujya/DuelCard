<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>DUELYST</title>
    <link rel="icon" type="image/gif" href="{{window.location.origin}}/favicon.gif">
    <link rel="shortcut icon" href="{{window.location.origin}}/favicon.ico">
    <meta name="description" content="">

    <!-- Mobile web configuration -->
    <!-- https://developer.mozilla.org/en-US/docs/Web/Guide/Mobile -->

    <!-- https://developer.mozilla.org/en-US/docs/Web/HTML/Viewport_meta_tag -->
    <meta id="duelyst-viewport" name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">

    <!-- https://developer.mozilla.org/en-US/docs/Web/API/CSS_Object_Model/Managing_screen_orientation -->
    <!-- Note: The orientation API may not be supported by Safari on Mac/iOS -->
    <!-- https://developer.mozilla.org/en-US/docs/Web/API/Screen/orientation#browser_compatibility -->
    <meta name="screen-orientation" content="landscape"/>
    <meta name="x5-orientation" content="landscape"/>

    <!-- Progressive Web App settings -->
    <!-- https://en.wikipedia.org/wiki/Progressive_web_app -->
    <!-- https://web.dev/native-hardware-fullscreen/#launching-a-page-fullscreen-from-home-screen -->
    <!-- See also: https://developer.chrome.com/blog/pwacompat/ -->
    <!-- This setting hides the status/navigation bar on Chrome apps -->
    <meta name="mobile-web-app-capable" content="yes"/>

    <!-- This setting hides the status/navigation bar on Safari apps -->
    <!-- https://developer.apple.com/library/archive/documentation/AppleApplications/Reference/SafariWebContent/ConfiguringWebApplications/ConfiguringWebApplications.html -->
    <!-- This appears to possibly be deprecated, with archived documentation -->
    <meta name="apple-mobile-web-app-capable" content="yes"/>

    <!-- End mobile web configuration -->

    <meta name="msapplication-tap-highlight" content="no">
    <meta name="full-screen" content="yes"/>
    <meta name="x5-fullscreen" content="true"/>

    <script type="text/javascript">
      // this is for cocos
      window.ccMapLimit = 100
    </script>

    <link rel="stylesheet" href="duelyst.css?v=20261124local4">
  </head>

  <body>
    <!-- application container div -->
    <div id="app">
      <div id="app-main">
        <div id="app-horizontal">
          <canvas id="app-gamecanvas"></canvas>
          <div id="app-content-region"></div>
          <div id="app-utility-region"></div>
        </div>
        <div id="app-vertical">
          <div id="app-modal-region"></div>
          <div id="app-notifications-region"></div>
        </div>
      </div>
      <div id="app-overlay-region"></div>
      <div id="maintenance-announcements-region"></div>
      <div id="app-preloading">
        <div class="brand-main">
          <h1>DUELYST</h1>
        </div>
        <img class="mystic-loader" src="loading.gif">
      </div>
    </div>
    <!-- end container div -->

    <script src="vendor.js" crossorigin></script>
    <script src="duelyst.js?v=20261124local6" crossorigin></script>

    <!-- Mobile fullscreen & landscape helper (active on mobile devices only) -->
    <style>
      html.mobile-browser,
      html.mobile-browser body,
      html.mobile-browser #app {
        min-width: 0 !important;
        min-height: 0 !important;
        width: 100vw !important;
        height: 100vh !important;
        overflow: hidden !important;
      }
      /* Mobile deck-select & practice mode: fix locked-card GPU compositing & ensure 3x2 grid fits */
      html.mobile-browser .deck-select .sliding-panel-select-header {
        padding-top: 0.8rem !important;
        padding-bottom: 0.6rem !important;
      }
      html.mobile-browser .deck-select .sliding-panel-select-footer {
        padding-top: 0.2rem !important;
        padding-bottom: 0.6rem !important;
      }
      html.mobile-browser .deck-select .sliding-panel-select-footer .btn-group {
        padding-bottom: 0.4rem !important;
      }
      html.mobile-browser .deck-select .deck-select-confirm,
      html.mobile-browser .deck-select .deck-select-confirm-casual {
        height: 8.0rem !important;
      }
      html.mobile-browser .deck-select .ai-opponent-select {
        max-height: 46.0rem !important;
      }
      html.mobile-browser .deck-select .sliding-panel-select-choices .choices {
        padding: 0 2.4rem !important;
        perspective: none !important;
        -webkit-perspective: none !important;
      }
      html.mobile-browser .deck-select .deck-preview {
        opacity: 1 !important;
        filter: none !important;
        -webkit-filter: none !important;
      }
      html.mobile-browser .deck-select .deck-preview.locked {
        opacity: 0.6 !important;
        filter: none !important;
        -webkit-filter: none !important;
      }
      html.mobile-browser .deck-select .deck-preview.locked .faction-portrait,
      html.mobile-browser .deck-select .deck-preview.locked .faction-crest {
        filter: grayscale(100%) brightness(0.8) !important;
        -webkit-filter: grayscale(100%) brightness(0.8) !important;
      }
      /* Mobile battle HUD & tutorial modal: larger, clearer typography for small landscape screens */
      html.mobile-browser #app-game .submit-turn {
        font-size: 2.3rem !important;
      }
      html.mobile-browser #app-game .player .user-name,
      html.mobile-browser #app-game .player .mana-count {
        font-size: 1.9rem !important;
      }
      html.mobile-browser #app-utility-region .utility-menu .btn {
        font-size: 1.55rem !important;
      }
      html.mobile-browser #tutorial-challenge-start .dialog-content {
        transform: scale(1.18);
        transform-origin: center center;
      }
      html.mobile-browser #tutorial-challenge-start .challenge-name {
        font-size: 2.2rem !important;
        line-height: 2.8rem !important;
      }
      html.mobile-browser #tutorial-challenge-start .challenge-difficulty {
        font-size: 1.6rem !important;
      }
      html.mobile-browser #tutorial-challenge-start .challenge-description {
        font-size: 1.75rem !important;
        line-height: 2.4rem !important;
      }
      html.mobile-browser #tutorial-challenge-start .btn.start {
        font-size: 1.8rem !important;
      }
      #mobile-landscape-overlay {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 999999;
        background: rgba(6, 12, 24, 0.94);
        color: #e8f1ff;
        font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 24px;
        box-sizing: border-box;
      }
      #mobile-landscape-overlay.visible {
        display: flex;
      }
      #mobile-landscape-overlay .ml-title {
        font-size: 22px;
        font-weight: 600;
        margin-bottom: 12px;
        letter-spacing: 1px;
      }
      #mobile-landscape-overlay .ml-desc {
        font-size: 14px;
        color: #9fb7d9;
        margin-bottom: 24px;
        line-height: 1.6;
        max-width: 320px;
      }
      #mobile-landscape-btn {
        background: linear-gradient(135deg, #00b4ff, #0066ff);
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 14px 28px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 4px 16px rgba(0, 140, 255, 0.4);
      }
      #mobile-landscape-skip {
        margin-top: 16px;
        background: transparent;
        border: none;
        color: #7d96b8;
        font-size: 13px;
        text-decoration: underline;
        cursor: pointer;
      }
      #mobile-fullscreen-fab {
        display: none;
        position: fixed;
        top: 4px;
        left: 50%;
        right: auto;
        transform: translateX(-50%);
        z-index: 999998;
        background: rgba(10, 20, 38, 0.65);
        color: #e8f1ff;
        border: 1px solid rgba(0, 180, 255, 0.45);
        border-radius: 999px;
        padding: 3px 10px;
        font-size: 11px;
        padding: 6px 10px;
        font-size: 12px;
        line-height: 1;
        cursor: pointer;
        backdrop-filter: blur(4px);
      }
      #mobile-fullscreen-fab.visible {
        display: block;
      }
      #mobile-fullscreen-fab.is-fullscreen {
        opacity: 0.55;
      }
    </style>
    <div id="mobile-landscape-overlay" role="dialog" aria-modal="true">
      <div class="ml-title">请使用横屏全屏游玩</div>
      <div class="ml-desc" id="mobile-landscape-desc">点击下方按钮进入全屏并锁定横屏模式</div>
      <button id="mobile-landscape-btn" type="button">进入全屏横屏</button>
      <button id="mobile-landscape-skip" type="button">暂时跳过</button>
    </div>
    <button id="mobile-fullscreen-fab" type="button">⛶ 全屏</button>
    <script type="text/javascript">
      (function () {
        var ua = navigator.userAgent || '';
        var isMobile = /Android|iPhone|iPad|iPod|Mobile|HarmonyOS/i.test(ua);
        if (!isMobile) return;

        var docEl = document.documentElement;
        docEl.classList.add('mobile-browser');

        var overlay = document.getElementById('mobile-landscape-overlay');
        var desc = document.getElementById('mobile-landscape-desc');
        var enterBtn = document.getElementById('mobile-landscape-btn');
        var skipBtn = document.getElementById('mobile-landscape-skip');
        var fab = document.getElementById('mobile-fullscreen-fab');
        var skipped = false;

        var reqFs = docEl.requestFullscreen || docEl.webkitRequestFullscreen || docEl.msRequestFullscreen;
        var supportsFs = typeof reqFs === 'function';

        function isFullscreen() {
          return !!(document.fullscreenElement || document.webkitFullscreenElement || document.msFullscreenElement);
        }

        function isPortrait() {
          return window.innerHeight > window.innerWidth;
        }

        function triggerResize() {
          setTimeout(function () {
            try { window.dispatchEvent(new Event('resize')); } catch (e) {}
          }, 250);
        }

        function enterFullscreenAndLandscape() {
          var p = null;
          if (supportsFs && !isFullscreen()) {
            try {
              p = reqFs.call(docEl, { navigationUI: 'hide' });
            } catch (e) {
              try { p = reqFs.call(docEl); } catch (e2) {}
            }
          }
          var lockOrientation = function () {
            if (screen.orientation && typeof screen.orientation.lock === 'function') {
              screen.orientation.lock('landscape').catch(function () {}).then(triggerResize);
            } else {
              triggerResize();
            }
          };
          if (p && typeof p.then === 'function') {
            p.then(lockOrientation).catch(lockOrientation);
          } else {
            lockOrientation();
          }
        }

        function exitFullscreenMode() {
          var exitFs = document.exitFullscreen || document.webkitExitFullscreen || document.msExitFullscreen;
          if (screen.orientation && typeof screen.orientation.unlock === 'function') {
            try { screen.orientation.unlock(); } catch (e) {}
          }
          if (typeof exitFs === 'function' && isFullscreen()) {
            try {
              var p = exitFs.call(document);
              if (p && typeof p.then === 'function') {
                p.catch(function () {}).then(triggerResize);
                return;
              }
            } catch (e) {}
          }
          triggerResize();
        }

        function updateUI() {
          var portrait = isPortrait();
          var fs = isFullscreen();
          if (portrait && !skipped) {
            if (!supportsFs) {
              desc.textContent = '当前浏览器不支持网页自动全屏，请手动横置手机游玩';
              enterBtn.style.display = 'none';
            } else {
              desc.textContent = '点击下方按钮进入全屏并强制锁定横屏模式';
              enterBtn.style.display = 'inline-block';
            }
            overlay.classList.add('visible');
            fab.classList.remove('visible');
          } else {
            overlay.classList.remove('visible');
            if (supportsFs) {
              fab.classList.add('visible');
              if (fs) {
                fab.textContent = '✕ 退出全屏';
                fab.classList.add('is-fullscreen');
              } else {
                fab.textContent = '⛶ 全屏';
                fab.classList.remove('is-fullscreen');
              }
            } else {
              fab.classList.remove('visible');
            }
          }
        }

        enterBtn.addEventListener('click', function () {
          enterFullscreenAndLandscape();
          setTimeout(updateUI, 400);
        });
        fab.addEventListener('click', function () {
          if (isFullscreen()) {
            exitFullscreenMode();
          } else {
            enterFullscreenAndLandscape();
          }
          setTimeout(updateUI, 400);
        });
        skipBtn.addEventListener('click', function () {
          skipped = true;
          updateUI();
        });

        window.addEventListener('resize', updateUI);
        window.addEventListener('orientationchange', function () {
          setTimeout(updateUI, 200);
        });
        document.addEventListener('fullscreenchange', updateUI);
        document.addEventListener('webkitfullscreenchange', updateUI);
        updateUI();
      })();
    </script>
  </body>
</html>
